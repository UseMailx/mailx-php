{
    "name": "mailx/sdk",
    "description": "Official PHP SDK for MailX",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/UseMailx/mailx-php",
    "support": {
        "issues": "https://github.com/UseMailx/mailx-php/issues",
        "source": "https://github.com/UseMailx/mailx-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MailX\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailX\\Tests\\": "tests/"
        }
    }
}
